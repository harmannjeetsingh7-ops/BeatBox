@model BeatBox.Models.Playlist

@{
    ViewData["Title"] = "Delete Playlist";
}

<h1>Delete Playlist</h1>

<h4>Are you sure you want to delete this playlist?</h4>
<hr />

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Genre</dt>
    <dd class="col-sm-9">@Model.Genre</dd>

    <dt class="col-sm-3">Created Date</dt>
    <dd class="col-sm-9">@Model.CreatedDate</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="PlaylistId" />

    <input type="submit"
           value="Delete"
           class="btn btn-danger" />

    <a asp-action="Index"
       class="btn btn-secondary">Cancel</a>
</form>
